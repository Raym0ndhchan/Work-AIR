{
  "source": {
    "base_url": "https://api.adsb.lol"
  },
  "collect": {
    "duration_sec": 300,
    "poll_interval_sec": 5,
    "output_dir": "data/adsb_runs",
    "save_raw_snapshots": true,
    "request_timeout_sec": 20
  },
  "selector": {
    "mode": "aircraft_global_grid",
    "endpoint_override": null,
    "value": null,
    "geo": {
      "lat": null,
      "lon": null,
      "radius_nm": 250
    },
    "global_points": []
  },
  "schema": {
    "profile": "extended",
    "include_null_advanced": true
  }
}
